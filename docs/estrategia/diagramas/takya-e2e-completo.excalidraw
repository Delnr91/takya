   "y": 234,
   "width": 403.0,
   "height": 315.3,
   "angle": 0,
   "strokeColor": "#1e2a24",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
