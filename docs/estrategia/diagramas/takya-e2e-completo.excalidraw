  {
   "id": "text-1018",
   "type": "text",
   "x": 964.0,
   "y": 248,
   "width": 375.0,
   "height": 243.1,
   "angle": 0,
   "strokeColor": "#1e2a24",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
