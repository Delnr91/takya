   "link": null,
   "locked": false
  },
  {
   "id": "text-1024",
   "type": "text",
   "x": 2341.0,
   "y": 248,
   "width": 375.0,
   "height": 221.0,
   "angle": 0,
   "strokeColor": "#1e2a24",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
