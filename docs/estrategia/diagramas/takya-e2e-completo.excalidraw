   "roundness": null,
   "seed": 1024,
   "version": 1,
   "versionNonce": 7168,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792440000000,
   "link": null,
   "locked": false,
   "text": "PRINCIPIOS\n\n• Humano al mando: la IA no decide, borra\nni despacha.\n• Dos caminos: preservar ≠ analizar.\n• Fallido/cancelado ≠ «sin candidatos».\n• Sin identidad ni intención; sin\nbiometría.\n• Local primero, sin nube obligatoria.\n• Mínimo dato; sin vigilar al trabajador.",
   "originalText": "PRINCIPIOS\n\n• Humano al mando: la IA no decide, borra\nni despacha.\n• Dos caminos: preservar ≠ analizar.\n• Fallido/cancelado ≠ «sin candidatos».\n• Sin identidad ni intención; sin\nbiometría.\n• Local primero, sin nube obligatoria.\n• Mínimo dato; sin vigilar al trabajador.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "rectangle-1023",
   "autoResize": false,
   "lineHeight": 1.3
  },
  {
   "id": "rectangle-1025",
   "type": "rectangle",
   "x": 2770.0,
   "y": 234,
   "width": 403.0,
   "height": 315.3,
   "angle": 0,
   "strokeColor": "#1e2a24",
   "backgroundColor": "#d0bfff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
