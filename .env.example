# Opcional. La consola, los videos y el botón Guíame funcionan sin esta clave.
# Para habilitar las consultas a Groq, copia este archivo a .env.local,
# configura una clave privada y reinicia el servidor. Nunca uses NEXT_PUBLIC_.
GROQ_API_KEY=

# Obligatorio para entrar a la demo privada (usuario fijo: centinela).
# Genera ambos valores con: node scripts/access/hash-password.mjs ~/takya-acceso.txt
# Sin ellos, la demo y sus APIs quedan cerradas.
TAKYA_DEMO_PASSWORD_HASH=
TAKYA_ACCESS_SECRET=
