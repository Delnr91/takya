{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://takya.local/contracts/v1/observation.json",
  "title": "Observation · detección + regla (autoridad: worker). No es un delito confirmado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_id", "job_id", "track_id", "category", "interval", "samples", "detector", "rule"],
  "properties": {
    "id": { "$ref": "defs.json#/definitions/observationId" },
    "source_id": { "$ref": "defs.json#/definitions/sourceId" },
    "job_id": { "$ref": "defs.json#/definitions/jobId" },
    "track_id": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "category": { "type": "string", "const": "person_in_declared_zone" },
    "interval": { "$ref": "defs.json#/definitions/interval" },
    "samples": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["pts_ms", "bbox_norm", "score", "inside_zone"],
        "properties": {
          "pts_ms": { "$ref": "defs.json#/definitions/ms" },
          "bbox_norm": { "$ref": "defs.json#/definitions/bboxNorm" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "inside_zone": { "type": "boolean" }
        }
      }
    },
    "detector": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "weights_sha256"],
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "version": { "type": "string", "maxLength": 40 },
        "weights_sha256": { "$ref": "defs.json#/definitions/sha256" }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["rule_version", "zone_version", "dwell_ms"],
      "properties": {
        "rule_version": { "type": "string", "const": "zone-rule-v1" },
        "zone_version": { "type": "integer", "minimum": 1 },
        "dwell_ms": { "type": "integer", "minimum": 500, "maximum": 10000 }
      }
    }
  }
}
