{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://takya.local/contracts/v1/defs.json",
  "title": "Definiciones comunes TAKYA v1",
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "point": { "type": "array", "items": { "$ref": "#/definitions/unit" }, "minItems": 2, "maxItems": 2 },
    "bboxNorm": { "type": "array", "items": { "$ref": "#/definitions/unit" }, "minItems": 4, "maxItems": 4 },
    "sessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9_-]{16,64}$" },
    "sourceId": { "type": "string", "pattern": "^src_[A-Za-z0-9_-]{16,64}$" },
    "jobId": { "type": "string", "pattern": "^job_[A-Za-z0-9_-]{16,64}$" },
    "observationId": { "type": "string", "pattern": "^obs_[A-Za-z0-9_-]{16,64}$" },
    "incidentId": { "type": "string", "pattern": "^inc_[A-Za-z0-9_-]{16,64}$" },
    "decisionId": { "type": "string", "pattern": "^dec_[A-Za-z0-9_-]{16,64}$" },
    "packageId": { "type": "string", "pattern": "^pkg_[A-Za-z0-9_-]{16,64}$" },
    "stillId": { "type": "string", "pattern": "^stl_[A-Za-z0-9_-]{16,64}$" },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "$ref": "#/definitions/ms" },
        "end_ms": { "$ref": "#/definitions/ms" }
      }
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
