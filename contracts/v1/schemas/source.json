{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://takya.local/contracts/v1/source.json",
  "title": "Source · fuente recibida (autoridad: servidor)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "session_id", "sha256", "size_bytes", "display_name", "container", "video_codec",
    "width", "height", "duration_ms", "time_base", "video_stream_count", "other_streams",
    "received_at", "capture_time", "capture_time_provenance", "authorization_acknowledged"
  ],
  "properties": {
    "id": { "$ref": "defs.json#/definitions/sourceId" },
    "session_id": { "$ref": "defs.json#/definitions/sessionId" },
    "sha256": { "$ref": "defs.json#/definitions/sha256" },
    "size_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^/\\\\\\u0000]+$" },
    "container": { "type": "string", "enum": ["mp4"] },
    "video_codec": { "type": "string", "enum": ["h264"] },
    "width": { "type": "integer", "minimum": 16, "maximum": 1280 },
    "height": { "type": "integer", "minimum": 16, "maximum": 720 },
    "duration_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
    "time_base": { "type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" },
    "video_stream_count": { "type": "integer", "const": 1 },
    "other_streams": {
      "type": "array", "maxItems": 2,
      "items": { "type": "string", "enum": ["aac_audio"] }
    },
    "received_at": { "$ref": "defs.json#/definitions/utc" },
    "capture_time": { "oneOf": [{ "type": "null" }, { "$ref": "defs.json#/definitions/utc" }] },
    "capture_time_provenance": { "type": "string", "enum": ["unknown", "operator_declared"] },
    "authorization_acknowledged": { "type": "boolean", "const": true }
  }
}
