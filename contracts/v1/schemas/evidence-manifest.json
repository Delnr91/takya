{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://takya.local/contracts/v1/evidence-manifest.json",
  "title": "takya-evidence-v1 · manifiesto determinista. Formato propio: no acredita ONVIF, ISO ni C2PA.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "package_id", "created_at", "level", "source_id", "files", "relations", "transformations", "context", "analysis_ref", "decision_ref", "capture_time", "identity_scope", "review_status"],
  "properties": {
    "format": { "type": "string", "const": "takya-evidence-v1" },
    "package_id": { "$ref": "defs.json#/definitions/packageId" },
    "created_at": { "$ref": "defs.json#/definitions/utc" },
    "level": { "type": "string", "enum": ["E1", "E2"] },
    "source_id": { "$ref": "defs.json#/definitions/sourceId" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256", "role"],
        "properties": {
          "path": { "$ref": "defs.json#/definitions/relPath" },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "sha256": { "$ref": "defs.json#/definitions/sha256" },
          "role": { "type": "string", "enum": ["source", "derivative_clip", "still_clean", "still_overlay", "analysis", "decision", "session_log", "verification_text"] }
        }
      }
    },
    "relations": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "kind"],
        "properties": {
          "from": { "$ref": "defs.json#/definitions/relPath" },
          "to": { "$ref": "defs.json#/definitions/relPath" },
          "kind": { "type": "string", "enum": ["derived_from", "overlay_of", "describes"] }
        }
      }
    },
    "transformations": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["tool", "tool_version", "operation", "audio_removed"],
        "properties": {
          "tool": { "type": "string", "maxLength": 40 },
          "tool_version": { "type": "string", "maxLength": 80 },
          "operation": { "type": "string", "enum": ["stream_copy_cut", "remux", "frame_extract_png", "downscale_for_analysis"] },
          "audio_removed": { "type": "boolean" }
        }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["requested", "effective", "mapping_proven"],
      "properties": {
        "requested": { "$ref": "defs.json#/definitions/interval" },
        "effective": { "$ref": "defs.json#/definitions/interval" },
        "mapping_proven": { "type": "boolean" }
      }
    },
    "analysis_ref": { "$ref": "defs.json#/definitions/relPath" },
    "decision_ref": { "oneOf": [{ "type": "null" }, { "$ref": "defs.json#/definitions/relPath" }] },
    "capture_time": { "oneOf": [{ "type": "null" }, { "$ref": "defs.json#/definitions/utc" }] },
    "identity_scope": { "type": "string", "const": "none" },
    "review_status": { "type": "string", "enum": ["HUMAN_REVIEWED", "SOURCE_RECEIVED_NO_HUMAN_REVIEW"] }
  }
}
